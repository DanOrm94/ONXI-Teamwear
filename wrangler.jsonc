{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onxi-teamwear",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "onxigripsocks.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.onxigripsocks.co.uk",
      "custom_domain": true
    }
  ]
}
